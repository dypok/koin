# Environment Mode
NODE_ENV=development
PORT=3000

# PostgreSQL Connection String (Heroku Postgres or Local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/koin

# JWT Secret for Session Signing (Min 32 characters)
JWT_SECRET=super_secret_jwt_key_koin_change_in_production_min32

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost
