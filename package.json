{
  "name": "koin-monorepo",
  "version": "0.4.2",
  "private": true,
  "description": "Koin - High-velocity multi-profile personal finance application",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@koin/server",
    "db:migrate": "turbo run db:migrate --filter=@koin/server",
    "start": "./apps/server/bin/api"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
